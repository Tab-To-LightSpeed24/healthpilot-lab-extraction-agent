# Copy to backend/.env and fill in.

# SQLite is used automatically if unset (fine for local dev/demo).
# For Postgres (docker-compose / Render): postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Required to actually process documents. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared API key. When set, every route except /health requires an X-API-Key header
# (the web UI asks for it once). Leave empty for local dev. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Per-client requests/minute per instance (0 = unlimited).
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_UPLOADS_PER_MINUTE=20

# Documents processed at the same time (Postgres only; SQLite always runs one) and the
# process-wide cap on simultaneous LLM requests across all of them.
WORKER_CONCURRENCY=3
LLM_GLOBAL_CONCURRENCY=24

# Any vision-capable Gemini model id.
GEMINI_MODEL=gemini-3.8-flash
# AI extraction is optional. When disabled, unreachable, slow, or failing, documents
# are extracted by a local rule-based parser instead and flagged "lower accuracy".
LLM_ENABLED=true
# Per-request cap, and total wall-clock budget (incl. retries) before diverting to the fallback.
LLM_REQUEST_TIMEOUT_SECONDS=25
LLM_PAGE_BUDGET_SECONDS=45
# Local OCR (Tesseract) for scanned/image input when AI is unavailable. Leave TESSERACT_CMD
# empty to auto-detect; the Docker image installs Tesseract itself.
OCR_ENABLED=true
TESSERACT_CMD=
OCR_PAGE_TIMEOUT_SECONDS=40
# Background OCR threads. Keep 1 on a 512MB instance (one large-page OCR peaks ~424MB).
OCR_MAX_WORKERS=1
MAPPING_CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=*
MAX_UPLOAD_MB=15
